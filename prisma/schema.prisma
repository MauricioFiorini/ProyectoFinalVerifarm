// Modelo de datos de Verifarm.
//
// Por ahora solo estan el generador y la fuente de datos: los modelos son
// trabajo de la FASE 2 del roadmap (tareas 2.01 a 2.06) y los escribe una
// sola persona por vez, porque dos migraciones en paralelo rompen la base
// de todo el equipo.
//
// Ojo con una diferencia de Prisma 7 respecto de la 6: la URL de conexion
// NO va aca. Vive en `prisma.config.ts`, que la lee de la variable de
// entorno DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  ADMINISTRADOR
  FARMACEUTICO
  MEDICO
  ENFERMERO
}

enum TipoMovimiento {
  INGRESO
  EGRESO
}

enum UnidadMedida {
  MG
  ML
  G
  UI
  COMPRIMIDO
  AMPOLLA
  GOTA
}

enum Severidad {
  ALTA
  MEDIA
  BAJA
}

model Medicamento {
  /// Identificador unico generado para no exponer IDs incrementales ni depender del orden de insercion
  id String @id @default(uuid())

  /// El nombre de la droga es unico para evitar duplicados en el inventario.
  /// Es la clave principal de busqueda para los usuarios.
  nombre String @unique

  /// RxCUI: Codigo estandarizado de RxNorm.
  /// Es obligatorio y unico, ya que el motor de interacciones medicamentosas se basa en el.
  rxcui String @unique

  /// La unidad de medida de la presentacion, restringida por Enum para consistencia de datos.
  unidad UnidadMedida

  /// El limite para generar alertas visuales de reposicion en farmacia.
  stockMinimo Int @default(0)

  /// Soft delete: un medicamento no se borra fisicamente jamas.
  /// Borrarlo romperia el historial inmutable de movimientos y prescripciones clinicas.
  activo Boolean @default(true)

  /// Un medicamento tiene multiples lotes asociados a lo largo del tiempo
  lotes Lote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lote {
  /// UUID para ocultar volumen de lotes cargados
  id String @id @default(uuid())

  medicamentoId String
  /// onCascade: si se elimina un medicamento (fisicamente, aunque no se deba), se eliminan sus lotes
  medicamento   Medicamento @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)

  /// Identificador alfanumerico del fabricante
  numeroLote String

  /// Requisito clave para FEFO (First Expired, First Out)
  fechaVencimiento DateTime

  movimientos MovimientoStock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// No pueden existir dos lotes con el mismo numero para un mismo medicamento
  @@unique([medicamentoId, numeroLote])
}

model MovimientoStock {
  id String @id @default(uuid())

  loteId String
  /// onCascade: si se elimina un lote, se eliminan sus movimientos
  lote   Lote   @relation(fields: [loteId], references: [id], onDelete: Cascade)

  /// Enum: INGRESO o EGRESO
  tipo TipoMovimiento

  /// Cantidad absoluta del movimiento.
  /// NOTA DE DISEÑO: No hay campo de saldo o cantidad restante en Lote.
  /// Por reglas de dominio, el saldo se calcula al vuelo restando egresos de ingresos.
  cantidad Int

  /// El historial de movimientos es inmutable
  createdAt DateTime @default(now())
}
